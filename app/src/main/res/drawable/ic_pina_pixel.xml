<?xml version="1.0" encoding="utf-8"?>
<!-- Piña en estilo pixel art (cuadrícula de 16x16) con hojas verdes y cuerpo dorado -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/tamano_pina_pixel"
    android:height="@dimen/tamano_pina_pixel"
    android:viewportWidth="16"
    android:viewportHeight="16">

    <!-- Corona de hojas saludables -->
    <path
        android:fillColor="@color/verde_salud_primario"
        android:pathData="M7,1h2v1h-2z M5,2h2v1h-2z M9,2h2v1h-2z M7,2h2v2h-2z M6,3h4v1h-4z M7,4h2v1h-2z" />

    <!-- Cuerpo dorado de la piña -->
    <path
        android:fillColor="@color/pina_dorada"
        android:pathData="M5,5h6v1h-6z M4,6h8v2h-8z M4,8h8v2h-8z M4,10h8v2h-8z M5,12h6v2h-6z M6,14h4v1h-4z" />

    <!-- Detalles en cuadrícula para simular textura de piña -->
    <path
        android:fillColor="@color/pina_amarillo_suave"
        android:pathData="M6,6h1v1h-1z M9,6h1v1h-1z M7,8h2v1h-2z M5,9h1v1h-1z M10,9h1v1h-1z M7,11h2v1h-2z" />

    <!-- Contorno sutil verde oscuro -->
    <path
        android:fillColor="@color/verde_salud_oscuro"
        android:pathData="M5,5h1v1h-1z M10,5h1v1h-1z M4,6h1v6h-1z M11,6h1v6h-1z M5,12h1v2h-1z M10,12h1v2h-1z M6,14h4v1h-4z" />
</vector>